        "z": "tab_ros2_demo",
        "name": "",
        "connection": "conn_turtlesim",
        "topic": "/turtle1/cmd_vel",
        "rosType": "geometry_msgs/msg/Twist",
        "validation": "strict",
        "latch": false,
        "allowOverride": false,
        "x": 450,
        "y": 240,
        "wires": [
            []
        ]
    },
    {
        "id": "catch_pub",
        "type": "catch",
        "z": "tab_ros2_demo",
        "name": "validation errors",
        "scope": [
            "pub_cmd"
