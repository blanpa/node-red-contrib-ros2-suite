[
    {
        "id": "tab_ros2_demo",
        "type": "tab",
        "label": "ROS 2 turtlesim",
        "disabled": false,
        "info": "Demo for node-red-contrib-ros2-suite against turtlesim.\n\nStart the stack with `cd docker && docker compose up --build`, or run rosbridge + turtlesim on your own ROS 2 machine and change the connection host."
    },
    {
        "id": "conn_turtlesim",
        "type": "ros2-connection",
        "name": "turtlesim",
        "host": "localhost",
        "port": 9090,
        "tls": false,
        "path": "",
        "url": "",
        "reconnectMin": 1,
        "reconnectMax": 30,
        "serviceTimeout": 10
    },
    {
        "id": "c_sub",
        "type": "comment",
        "z": "tab_ros2_demo",
        "name": "Subscribe: pose (status shows Hz)",
        "info": "The debug node is off by default — pose arrives at ~60 Hz. Enable it to see messages.",
        "x": 170,
        "y": 60,
        "wires": []
    },
    {
        "id": "sub_pose",
        "type": "ros2-subscribe",
        "z": "tab_ros2_demo",
        "name": "",
        "connection": "conn_turtlesim",
        "topic": "/turtle1/pose",
        "rosType": "",
        "throttle": 0,
        "queue": 1,
        "x": 170,
        "y": 100,
        "wires": [
            [
                "dbg_pose"
            ]
        ]
    },
    {
        "id": "dbg_pose",
        "type": "debug",
        "z": "tab_ros2_demo",
        "name": "pose",
        "active": false,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 430,
        "y": 100,
        "wires": []
    },
    {
